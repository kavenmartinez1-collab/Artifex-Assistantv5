{
  "name": "artifex-webgpu",
  "version": "0.1.0",
  "description": "Artifex WebGPU Inference Engine — browser-based LLM inference for any GPU",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx server/dev-server.ts\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "cors": "2.8.6",
    "express": "4.22.1",
    "ws": "8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/ws": "8.18.1",
    "@webgpu/types": "0.1.69",
    "concurrently": "9.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  }
}
