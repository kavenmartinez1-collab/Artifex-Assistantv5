{
  "_comment": "llama.cpp server config. Copy to llama_cpp_config.json and update paths.",
  "server_path": "/path/to/llama-mainline/llama.cpp/build/bin/llama-server",
  "default_port": 8081,
  "models": {
    "qwen3.6-27b-256k": {
      "_comment": "C3-256K: max context, q4_0 KV, no spec-dec. ~22 GB VRAM. No --cache-reuse (breaks hybrid DeltaNet state).",
      "path": "/path/to/Qwen3.6-27B-Q4_K_M.gguf",
      "num_gpu_layers": 99,
      "num_ctx": 262144,
      "extra_flags": [
        "-fa", "on",
        "-ctk", "q4_0", "-ctv", "q4_0",
        "--swa-full",
        "--jinja",
        "--reasoning-format", "deepseek",
        "--metrics"
      ]
    },
    "qwen3.6-27b-8k-specd": {
      "_comment": "C1-agg: 8K ctx + Qwen3.5-4B spec-dec. ~22 GB VRAM, 43/67 tok/s mean/peak. Fast chat + vision.",
      "path": "/path/to/Qwen3.6-27B-Q4_K_M.gguf",
      "num_gpu_layers": 99,
      "num_ctx": 8192,
      "extra_flags": [
        "-fa", "on",
        "-ctk", "q8_0", "-ctv", "q8_0",
        "--swa-full",
        "-md", "/path/to/Qwen3.5-4B-Q4_K_M.gguf",
        "-ngld", "99", "-cd", "4096",
        "--draft-max", "16", "--draft-min", "4", "--draft-p-min", "0.5",
        "--jinja",
        "--reasoning-format", "deepseek",
        "--metrics",
        "--mmproj", "/path/to/mmproj-F16.gguf"
      ]
    }
  }
}
