# ─────────────────────────────────────────────────────────────────────
#  Artifex Assistant V5 — .gitignore
# ─────────────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Node.js (WebGPU engine) ─────────────────────────────────────────
webgpu/node_modules/
webgpu/dist/
webgpu/metrics.jsonl

# ── Local data (NEVER commit — user-specific, large, or generated) ──
models/*
sessions/*
!sessions/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
.tool_cache/

# ── Knowledge base workspace data (user-specific, per-machine) ──────
knowledge/workspaces/
knowledge/reference/entries/*
!knowledge/reference/entries/.gitkeep

# ── Secrets and credentials ─────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.crt
credentials.json
secrets.*
id_rsa*

# ── IDE and editor files ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# ── OS files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Testing and caching ────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Claude Code (session-specific, contains auth tokens) ────────────
.claude/

# ── Docker build artifacts ──────────────────────────────────────────
*.tar
*.tar.gz

# ── Machine-specific configs (contain local filesystem paths) ──────
Modelfile
Modelfile.*
!Modelfile.example
llama_cpp_config.json
claude_cli_config.json

# ── Debug output and session notes (personal, not project code) ───
SESSION-NOTES.md
PICKUP.md
debug*.json
webgpu/debug-output.json
webgpu/debug-output.*.json
scripts/reference_output.txt
reference_dump*.json
weight_sweep*.json

# ── Local bench evidence dumps (WebGPU A/B toggles, run logs) ───────
/log.txt
scripts/ab_*.txt

# ── Session-specific diagnostic probes (one-off investigation tools) ─
scripts/l21_*.py
scripts/zero_offset_probe*.py
scripts/gidx_trivial_probe.py
scripts/run-probe*.sh
scripts/run-test.sh
scripts/run-temp-test.sh

# ── Runtime / temp files ────────────────────────────────────────────
*.log
*.pid
*.sock
research/
control-center/node_modules/

# ── Third-party source for in-tree backend builds (llama.cpp, etc.) ──
vendor/
