# ─────────────────────────────────────────────────────────────────────
#  Artifex Assistant V5 — .gitignore
# ─────────────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────────────
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
*.whl

# ── Node.js (WebGPU engine) ─────────────────────────────────────────
webgpu/node_modules/
webgpu/dist/
webgpu/metrics.jsonl

# ── Local data (NEVER commit — user-specific, large, or generated) ──
models/*
!models/.gitkeep
sessions/*
!sessions/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
.tool_cache/

# ── Knowledge base workspace data (user-specific, per-machine) ──────
knowledge/workspaces/
knowledge/reference/entries/*
!knowledge/reference/entries/.gitkeep

# ── Secrets and credentials ─────────────────────────────────────────
.env
.env.*
*.pem
*.key
*.crt
credentials.json
secrets.*
id_rsa*

# ── IDE and editor files ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-project
*.sublime-workspace

# ── OS files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Testing and caching ────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Claude Code (session-specific, contains auth tokens) ────────────
.claude/

# ── Docker build artifacts ──────────────────────────────────────────
*.tar
*.tar.gz

# ── Debug output and session notes (personal, not project code) ───
SESSION-NOTES.md
debug*.json
webgpu/debug-output.json
scripts/reference_output.txt

# ── Runtime / temp files ────────────────────────────────────────────
*.log
*.pid
*.sock
